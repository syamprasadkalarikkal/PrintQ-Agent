{
  "name": "printq-agent",
  "version": "1.0.0",
  "description": "PrintQ Smart Self-Service Printing Agent",
  "author": "Syam Prasad",
  "license": "ISC",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/start-electron.js .",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "icons": "node scripts/generate-icons.js"
  },
  "build": {
    "appId": "com.syam.printagent",
    "productName": "PrintQ Agent",
    "files": [
      "**/*",
      "!**/.env",
      "!dist/**/*",
      "!node_modules/.cache/**/*"
    ],
    "icon": "assets/icons",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "**/node_modules/pdf-to-printer/**/*"
    ]
  },
  "keywords": [
    "printq",
    "printing",
    "electron",
    "supabase"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "axios": "^1.16.1",
    "pdf-to-printer": "^5.8.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  }
}