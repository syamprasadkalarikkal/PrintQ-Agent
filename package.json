{
  "name": "printq-agent",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start-electron.js .",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "icons": "node scripts/generate-icons.js"
  },
  "build": {
    "appId": "com.syam.printagent",
    "productName": "PrintQ Agent",
    "icon": "assets/icons",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "**/node_modules/pdf-to-printer/**/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "axios": "^1.16.1",
    "pdf-to-printer": "^5.8.0",
    "qrcode": "^1.5.4",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  }
}
